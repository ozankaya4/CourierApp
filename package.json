{
  "name": "courier",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @courier/web",
    "dev:mobile": "npm run start --workspace @courier/mobile",
    "build:web": "npm run build --workspace @courier/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write apps packages tests docs README.md package.json tsconfig.base.json",
    "check": "npm run typecheck && npm test && npm run build:web"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.3",
    "prettier": "3.9.7",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
